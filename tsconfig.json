{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": [
      "ES2020",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "skipLibCheck": true,
    "ignoreDeprecations": "5.0",
    "isolatedModules": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "types": [
      "vite/client",
      "node",
      "react",
      "cypress"
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "lucide-react": [
        "./src/shims/lucide-react.tsx"
      ],
      "sonner": [
        "./src/shims/sonner.tsx"
      ],
      "figma:asset/*": [
        "./src/assets/*"
      ]
    }
  },
  "include": [
    "src",
    "cypress"
  ]
}
