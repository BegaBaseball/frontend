{
  "name": "bega-frontend",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22 <23",
    "npm": ">=10 <11"
  },
  "dependencies": {
    "@stomp/stompjs": "^7.2.1",
    "@tanstack/react-query": "^5.90.7",
    "@tosspayments/tosspayments-sdk": "^2.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.9.6",
    "sockjs-client": "^1.6.1",
    "zustand": "^5.0.10"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.27.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.2.6",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.3",
    "autoprefixer": "^10.4.23",
    "cypress": "^15.13.0",
    "postcss": "^8.5.6",
    "start-server-and-test": "^2.1.3",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "wrangler": "^4.72.0"
  },
  "scripts": {
    "dev": "npx vite",
    "build:base": "npx vite build && node scripts/dist-assets.mjs --prune --report reports/dist-assets-report.json && node scripts/bundle-guard.mjs --report reports/bundle-guard-report.json",
    "build:artifact": "npm run build",
    "seo:prerender": "node scripts/prerender-seo.mjs",
    "seo:sitemap": "node scripts/generate-sitemap.mjs",
    "seo:check": "node scripts/seo-audit.mjs",
    "seo:helmet:check": "node scripts/helmet-runtime-check.mjs",
    "seo:env:check": "node scripts/seo-env-check.mjs",
    "seo:env:check:strict": "node scripts/seo-env-check.mjs --strict",
    "seo:smoke:prod": "node scripts/seo-postdeploy-smoke.mjs --report reports/seo-postdeploy-smoke.json",
    "smoke:auth:public:prod": "node scripts/auth-public-postdeploy-smoke.mjs --report reports/auth-public-postdeploy-smoke.json",
    "seo:gate": "npm run build && node scripts/seo-audit.mjs --report reports/seo-audit-report.json",
    "log:audit": "node scripts/log-audit.mjs",
    "log:audit:strict": "node scripts/log-audit.mjs --strict",
    "prebuild": "npm run log:audit:strict && npm run seo:env:check",
    "cwv:baseline": "node scripts/cwv-baseline.mjs --json reports/cwv-baseline.json --markdown reports/cwv-baseline.md",
    "build": "npm run build:base && npm run seo:prerender && npm run seo:sitemap",
    "bundle:guard": "node scripts/bundle-guard.mjs --report reports/bundle-guard-report.json",
    "dist:assets:report": "node scripts/dist-assets.mjs --report reports/dist-assets-report.json",
    "dist:assets:prune": "node scripts/dist-assets.mjs --prune --report reports/dist-assets-report.json",
    "preview": "npm run preview:cloudflare",
    "preview:cloudflare": "npm run build && wrangler dev",
    "qa:landing": "node scripts/landing-qa.mjs",
    "qa:auth": "node scripts/auth-qa.mjs",
    "qa:mobile:summary": "node scripts/mobile-playwright-summary.mjs",
    "qa:mobile:smoke": "npm run qa:prediction:mobile:smoke && npm run qa:mate:mobile:smoke && npm run qa:mobile:summary",
    "qa:mobile:smoke:attached": "npm run qa:prediction:mobile:smoke:attached && npm run qa:mate:mobile:smoke:attached && npm run qa:mobile:summary",
    "qa:mate:mobile": "node ../output/playwright/run-mate-mobile-regression.mjs",
    "qa:mate:mobile:smoke": "MATE_MOBILE_SUITES=detail,create,list node ../output/playwright/run-mate-mobile-regression.mjs",
    "qa:mate:mobile:attached": "AUDIT_BASE_URL=${AUDIT_BASE_URL:-http://127.0.0.1:5176} MATE_MOBILE_AUTO_START_DEV_SERVER=0 node ../output/playwright/run-mate-mobile-regression.mjs",
    "qa:mate:mobile:smoke:attached": "AUDIT_BASE_URL=${AUDIT_BASE_URL:-http://127.0.0.1:5176} MATE_MOBILE_SUITES=detail,create,list MATE_MOBILE_AUTO_START_DEV_SERVER=0 node ../output/playwright/run-mate-mobile-regression.mjs",
    "qa:prediction:mobile": "node ../output/playwright/run-prediction-mobile-regression.mjs",
    "qa:prediction:mobile:smoke": "PREDICTION_MOBILE_STATES=match,ranking,ranking-save-dialog,ranking-saved,detail-error node ../output/playwright/run-prediction-mobile-regression.mjs",
    "qa:prediction:mobile:attached": "AUDIT_BASE_URL=${AUDIT_BASE_URL:-http://127.0.0.1:5176} PREDICTION_MOBILE_AUTO_START_DEV_SERVER=0 node ../output/playwright/run-prediction-mobile-regression.mjs",
    "qa:prediction:mobile:smoke:attached": "AUDIT_BASE_URL=${AUDIT_BASE_URL:-http://127.0.0.1:5176} PREDICTION_MOBILE_STATES=match,ranking,ranking-save-dialog,ranking-saved,detail-error PREDICTION_MOBILE_AUTO_START_DEV_SERVER=0 node ../output/playwright/run-prediction-mobile-regression.mjs",
    "qa:prediction:mobile:audit": "node ../output/playwright/prediction-mobile-audit.mjs",
    "cy:doctor": "node scripts/cypress-doctor.mjs",
    "cy:doctor:global": "node scripts/cypress-doctor.mjs --global-cache",
    "cy:open": "node scripts/cypress-run.mjs --open",
    "cy:run": "node scripts/cypress-run.mjs",
    "cy:run:docker": "CYPRESS_USE_DOCKER=1 node scripts/cypress-run.mjs",
    "cy:run:global": "node scripts/cypress-run.mjs --global-cache",
    "cy:run:coach": "node scripts/cypress-run.mjs --spec cypress/e2e/prediction-coach-briefing.cy.ts,cypress/e2e/prediction.cy.ts",
    "cy:run:coach:chrome": "node scripts/cypress-run.mjs --browser chrome --spec cypress/e2e/prediction-coach-briefing.cy.ts,cypress/e2e/prediction.cy.ts",
    "cy:run:rescue": "node scripts/cypress-run.mjs --self-heal --auto-docker",
    "cy:run:global:docker": "CYPRESS_USE_DOCKER=1 node scripts/cypress-run.mjs --global-cache --docker",
    "cy:run:heal": "node scripts/cypress-run.mjs --self-heal",
    "cy:run:global:heal": "node scripts/cypress-run.mjs --global-cache --self-heal",
    "cy:run:global:docker:heal": "CYPRESS_USE_DOCKER=1 node scripts/cypress-run.mjs --global-cache --self-heal --docker",
    "cy:install": "CYPRESS_CACHE_FOLDER=$PWD/.cypress-cache npx cypress install",
    "cy:doctor:repair": "node scripts/cypress-doctor.mjs --repair",
    "cy:doctor:repair:global": "node scripts/cypress-doctor.mjs --repair --global-cache",
    "test:e2e:docker": "node scripts/test-e2e.mjs --docker",
    "test:e2e:attach": "node scripts/test-e2e.mjs --no-server --auto-docker",
    "test:e2e:rescue": "node scripts/test-e2e.mjs --auto-docker",
    "test:e2e:full:dev": "node scripts/test-e2e.mjs --host 127.0.0.1",
    "test:e2e:full:prodlike": "node scripts/test-e2e.mjs --no-server",
    "test:e2e:full:prodlike:docker": "node scripts/test-e2e.mjs --no-server --docker",
    "test:e2e:auth:dev": "node scripts/test-e2e.mjs --host 127.0.0.1 --spec cypress/e2e/auth.cy.ts,cypress/e2e/auth-signup-availability.cy.ts",
    "test:e2e:auth:prodlike": "node scripts/test-e2e.mjs --no-server --spec cypress/e2e/auth.cy.ts,cypress/e2e/auth-signup-availability.cy.ts",
    "test:e2e:smoke:dev": "node scripts/test-e2e.mjs --host 127.0.0.1 --spec cypress/e2e/auth.cy.ts,cypress/e2e/auth-signup-availability.cy.ts,cypress/e2e/cheer-board.cy.ts,cypress/e2e/mypage.cy.ts,cypress/e2e/stadium.cy.ts",
    "test:e2e:smoke:prodlike": "node scripts/test-e2e.mjs --no-server --spec cypress/e2e/auth.cy.ts,cypress/e2e/auth-signup-availability.cy.ts,cypress/e2e/cheer-board.cy.ts,cypress/e2e/mypage.cy.ts,cypress/e2e/stadium.cy.ts",
    "test:e2e:smoke:prodlike:docker": "node scripts/test-e2e.mjs --no-server --docker --spec cypress/e2e/auth.cy.ts,cypress/e2e/auth-signup-availability.cy.ts,cypress/e2e/cheer-board.cy.ts,cypress/e2e/mypage.cy.ts,cypress/e2e/stadium.cy.ts",
    "test:e2e:diary:dev": "node scripts/test-e2e.mjs --host 127.0.0.1 --spec cypress/e2e/diary.cy.ts",
    "test:e2e:admin:dev": "node scripts/test-e2e.mjs --host 127.0.0.1 --spec cypress/e2e/admin.cy.ts",
    "test:e2e:ai:dev": "node scripts/test-e2e.mjs --host 127.0.0.1 --spec cypress/e2e/chatbot.cy.ts",
    "test:e2e:ai:real": "node scripts/test-e2e.mjs --host 127.0.0.1 --spec cypress/e2e/chatbot-real.cy.ts",
    "test:e2e:coverage:dev": "node scripts/test-e2e.mjs --host 127.0.0.1 --spec cypress/e2e/diary.cy.ts,cypress/e2e/admin.cy.ts,cypress/e2e/chatbot.cy.ts",
    "test:e2e:coach:dev": "node scripts/test-e2e.mjs --host 127.0.0.1 --spec cypress/e2e/prediction-coach-briefing.cy.ts,cypress/e2e/prediction.cy.ts",
    "test:e2e:coach:dev:chrome": "node scripts/test-e2e.mjs --host 127.0.0.1 --browser chrome --spec cypress/e2e/prediction-coach-briefing.cy.ts,cypress/e2e/prediction.cy.ts",
    "test:e2e:coach:prodlike": "node scripts/test-e2e.mjs --no-server --spec cypress/e2e/prediction-coach-briefing.cy.ts,cypress/e2e/prediction.cy.ts",
    "test:e2e:security:dev": "node scripts/test-e2e.mjs --host 127.0.0.1 --spec cypress/e2e/security-surface-real.cy.ts,cypress/e2e/websocket-real.cy.ts",
    "test:e2e:security:prodlike": "node scripts/test-e2e.mjs --no-server --spec cypress/e2e/security-surface-real.cy.ts,cypress/e2e/websocket-real.cy.ts",
    "test:e2e:prediction:dev": "node scripts/test-e2e.mjs --host 127.0.0.1 --spec cypress/e2e/prediction.cy.ts,cypress/e2e/prediction-lazy-load.cy.ts,cypress/e2e/prediction-range-recovery.cy.ts,cypress/e2e/prediction-date-boundary.cy.ts,cypress/e2e/prediction-coach-briefing.cy.ts,cypress/e2e/home-to-prediction.cy.ts",
    "test:e2e:prediction:prodlike": "node scripts/test-e2e.mjs --no-server --spec cypress/e2e/prediction.cy.ts,cypress/e2e/prediction-lazy-load.cy.ts,cypress/e2e/prediction-range-recovery.cy.ts,cypress/e2e/prediction-date-boundary.cy.ts,cypress/e2e/prediction-coach-briefing.cy.ts,cypress/e2e/home-to-prediction.cy.ts",
    "test:e2e:prediction:rescue": "node scripts/test-e2e.mjs --auto-docker --host 127.0.0.1 --spec cypress/e2e/prediction.cy.ts,cypress/e2e/prediction-lazy-load.cy.ts,cypress/e2e/prediction-range-recovery.cy.ts,cypress/e2e/prediction-date-boundary.cy.ts,cypress/e2e/prediction-coach-briefing.cy.ts,cypress/e2e/home-to-prediction.cy.ts",
    "test:integration:real": "node scripts/real-integration-smoke.mjs",
    "smoke:home:contract:prod": "node scripts/home-widgets-contract-smoke.mjs --report reports/home-widgets-contract-smoke.json",
    "smoke:schedule:regression:prod": "node scripts/schedule-regression-smoke.mjs --report reports/schedule-regression-smoke.json",
    "test:e2e": "node scripts/test-e2e.mjs --host 127.0.0.1",
    "test:e2e:mate:smoke": "bash scripts/mate-smoke.sh",
    "test:e2e:mate:regression:route": "node scripts/test-e2e.mjs --host 127.0.0.1 --browser chrome --spec cypress/e2e/mate.cy.ts,cypress/e2e/mate-detail-states.cy.ts,cypress/e2e/mate-execution-flow.cy.ts,cypress/e2e/mate-qr-refresh.cy.ts",
    "test:e2e:mate:regression:create": "node scripts/test-e2e.mjs --host 127.0.0.1 --browser chrome --spec cypress/e2e/mate-create.cy.ts,cypress/e2e/mate-create-session-recovery.cy.ts,cypress/e2e/mate-apply-session-recovery.cy.ts,cypress/e2e/mate-selling-payment-success.cy.ts",
    "test:e2e:mate:regression:extended": "node scripts/test-e2e.mjs --host 127.0.0.1 --browser chrome --spec cypress/e2e/mate-chat-upload.cy.ts,cypress/e2e/mate-flow-policy.cy.ts,cypress/e2e/mate-visual.cy.ts",
    "test:e2e:mate:full": "npm run test:e2e:mate:regression:route && npm run test:e2e:mate:regression:create && npm run test:e2e:mate:regression:extended",
    "test:mobile:summary": "node --import tsx --test scripts/mobile-playwright-summary.test.ts",
    "test:mate:smoke": "node --import tsx --test src/hooks/mateRouteBarrels.test.ts src/hooks/mateQueryOptions.test.ts src/hooks/mateQueryCache.test.ts src/hooks/internal/mateQueryCacheUtils.test.ts src/utils/mateIdentity.test.ts src/utils/mateApplyDraft.test.ts src/utils/mateRouteState.test.ts src/utils/mateValidation.test.ts src/utils/mateCreateDraft.test.ts src/api/mate.test.ts scripts/mate-ci-summary-lib.test.ts scripts/mate-regression-label-policy.test.ts scripts/mate-ci-pr-comment-lib.test.ts",
    "qa:mate:regression:label": "node scripts/mate-regression-label-check.mjs",
    "test:seo": "node --import tsx --test \"src/seo/**/*.test.ts\"",
    "test:unit": "node --import tsx --test \"src/**/*.test.ts\"",
    "deploy": "npm run build:artifact",
    "deploy:cloudflare": "npm run build && wrangler deploy"
  }
}
