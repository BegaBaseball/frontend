# Frontend environment variables example

# 로컬: 프록시가 같은 기원에서 /api 를 제공할 때
VITE_API_BASE_URL=/api

# 운영/preview: API origin만 사용하고, 런타임이 `${origin}/api` 로 정규화합니다.
# 예시: https://api.begabaseball.xyz
# VITE_API_BASE_URL=https://api.begabaseball.xyz
# Legacy absolute values that already end with /api continue to work, but prefer the origin-only form above.

# 보안/통합 실전 테스트에서 사용할 백엔드 Base URL(절대 URL)
# 예시: http://localhost:8080 or https://api.begabaseball.xyz
# SECURITY 스펙에서 /actuator 및 protected endpoint를 직접 호출할 때 사용됩니다.
# BACKEND_BASE_URL=http://localhost:8080

# 로컬에서 Vite dev 서버를 직접 띄울 때의 프록시 대상 예시
# VITE_PROXY_TARGET=http://localhost:8080

# SEO 기준 URL (canonical / sitemap)
VITE_SITE_URL=https://www.begabaseball.xyz

# 선택: 분석/검색엔진 검증
# VITE_GA4_MEASUREMENT_ID=G-XXXXXXXXXX
# VITE_GOOGLE_SITE_VERIFICATION=google-site-verification-token
# VITE_NAVER_SITE_VERIFICATION=naver-site-verification-token

# AdSense / 광고 슬롯
# 전체 광고 on/off
VITE_ADS_ENABLED=true

# Wave 제어
VITE_ADS_WAVE1_ENABLED=true
VITE_ADS_WAVE2_ENABLED=false

# 강제 버킷 지정이 필요할 때만 사용
# VITE_ADS_FORCE_VARIANT=control
# VITE_ADS_FORCE_VARIANT=ads_wave1
# VITE_ADS_FORCE_VARIANT=ads_wave2

# Google AdSense
VITE_ADSENSE_CLIENT=ca-pub-xxxxxxxxxxxxxxxx
VITE_ADSENSE_TEST_MODE=true

# 슬롯별 AdSense unit id
VITE_ADSENSE_SLOT_CHEER_FEED_1=1234567890
VITE_ADSENSE_SLOT_HOME_MID_1=1234567891
VITE_ADSENSE_SLOT_STADIUM_PARTNER_1=1234567892
# VITE_ADSENSE_SLOT_CHEER_DETAIL_1=1234567893
# VITE_ADSENSE_SLOT_MATE_LIST_1=1234567894
# VITE_ADSENSE_SLOT_MATE_DETAIL_1=1234567895

# 슬롯별 개별 비활성화가 필요할 때만 사용
# VITE_AD_SLOT_CHEER_FEED_1_ENABLED=false
# VITE_AD_SLOT_HOME_MID_1_ENABLED=false
# VITE_AD_SLOT_STADIUM_PARTNER_1_ENABLED=false
# VITE_AD_SLOT_CHEER_DETAIL_1_ENABLED=false
# VITE_AD_SLOT_MATE_LIST_1_ENABLED=false
# VITE_AD_SLOT_MATE_DETAIL_1_ENABLED=false

# Mate 결제 모드
# DIRECT_TRADE: 앱 내 결제 비활성(직거래)
# TOSS_TEST: test_* 키 기반 무과금 결제 검증
VITE_MATE_PAYMENT_MODE=DIRECT_TRADE
VITE_TOSS_CLIENT_KEY=test_ck_your_toss_test_client_key

# Mate 계정 연동(카카오/네이버) 강제 여부
# 테스트 시 false로 두면 계정 연동 확인 다이얼로그를 띄우지 않습니다.
VITE_MATE_REQUIRE_SOCIAL_VERIFICATION=true
