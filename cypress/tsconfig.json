{
    "compilerOptions": {
        "target": "ES2020",
        "lib": [
            "ES2020",
            "DOM",
            "DOM.Iterable"
        ],
        "module": "ESNext",
        "skipLibCheck": true,
        "types": [
            "cypress"
        ],
        "moduleResolution": "bundler",
        "isolatedModules": true,
        "noEmit": true
    },
    "include": [
        "**/*.ts"
    ]
}